// Tambahkan 'fs' di bagian paling atas
const { default: makeWASocket, useMultiFileAuthState } = require('@whiskeysockets/baileys');
const pino = require('pino');
const fs = require('fs'); // Tambahan baru untuk database

// Memuat database jika ada, atau membuat objek kosong jika belum ada
let db = {};
if (fs.existsSync('./database.json')) {
    db = JSON.parse(fs.readFileSync('./database.json'));
}

function saveDB() {
    fs.writeFileSync('./database.json', JSON.stringify(db, null, 2));
}

async function startBot() {
    const { state, saveCreds } = await useMultiFileAuthState('./auth_info');

    const sock = makeWASocket({
        logger: pino({ level: 'silent' }),
        printQRInTerminal: true,
        auth: state,
        browser: ['Zekais Bot', 'Safari', '1.0.0']
    });

    sock.ev.on('creds.update', saveCreds);

    sock.ev.on('messages.upsert', async ({ messages, type }) => {
        const msg = messages[0];
        if (!msg.message || msg.key.fromMe) return;

        const text = msg.message.conversation || msg.message.extendedTextMessage?.text || "";
        const sender = msg.key.remoteJid;
        const pushName = msg.pushName || "Pengguna";
        const command = text.trim().split(" ")[0].toLowerCase();

        // --- SISTEM DATABASE USER ---
        // Jika user belum ada di database, buat profil baru
        if (!db[sender]) {
            db[sender] = { 
                nama: pushName, 
                level: 1, 
                coin: 0, 
                limit: 22, 
                point: 15, 
                lastMisi: 0 // Waktu terakhir klaim misi
            };
            saveDB();
        }

        let user = db[sender]; // Memanggil data user saat ini

        // ----------------- DAFTAR PERINTAH -----------------
        switch (command) {
            case '.menu':
            case '.help':
                // Menu sekarang menampilkan data asli dari database
                const menuText = `⬡ ᴢᴇᴋᴀɪꜱ ⊹ ʙ0ᴛ ⬡

> ⚠️ BOT ini *GRATIS* masuk Grupmu!

╭─「 👤 *ᴘʀᴏꜰɪʟ ᴜꜱᴇʀ* 」
│  🏷️  *Nama* ⟫  ${user.nama}
│  🎚️  *Level* ⟫  ${user.level}
│  💰  *Coin* ⟫  ${user.coin}
│  🎫  *Limit* ⟫  ${user.limit} / 22
│  🎮  *Point* ⟫  ${user.point} / 15
╰──⊷

_Hai Ka_ @${sender.split('@')[0]} 👋
_Aku BOT Game Pokemon & Mancing_ 🐾🐟

Ketik *.misi* untuk klaim harian!
Ketik *.mancing* untuk coba main.`;
                
                await sock.sendMessage(sender, { text: menuText, mentions: [sender] }, { quoted: msg });
                break;

            case '.misi':
                // Cek jeda 24 jam (86400000 milidetik)
                const waktuSekarang = Date.now();
                if (waktuSekarang - user.lastMisi < 86400000) {
                    await sock.sendMessage(sender, { text: '⏳ Kamu sudah menyelesaikan misi hari ini. Kembali lagi besok ya!' }, { quoted: msg });
                    break;
                }
                
                // Hadiah misi
                user.coin += 500;
                user.limit = 22; // Reset limit harian
                user.lastMisi = waktuSekarang;
                saveDB();

                await sock.sendMessage(sender, { text: '🎉 *Misi Selesai!*\nKamu mendapatkan +500 Coin dan Limit kamu direset menjadi 22.' }, { quoted: msg });
                break;

            case '.mancing':
            case '.fish':
                if (user.limit <= 0) {
                    await sock.sendMessage(sender, { text: '❌ Limit kamu habis! Tunggu reset besok atau beli limit.' }, { quoted: msg });
                    break;
                }

                user.limit -= 1; // Mengurangi limit setiap kali main
                
                // Sistem gacha ikan sederhana
                const ikan = ['🐟 Ikan Nila', '🐡 Ikan Buntal', '🦈 Hiu Mini', '🥾 Sepatu Bekas'];
                const dapat = ikan[Math.floor(Math.random() * ikan.length)];
                
                user.coin += (dapat === '🥾 Sepatu Bekas') ? 0 : 50; // Tambah koin jika dapat ikan
                saveDB();

                await sock.sendMessage(sender, { text: `🎣 Kamu melempar kail dan mendapatkan...\n\n*${dapat}*!\n(Sisa Limit: ${user.limit})` }, { quoted: msg });
                break;
        }
    });
}

startBot();
