# Gunakan image node versi terbaru yang stabil
FROM node:22-bullseye

# Instal library sistem yang dibutuhkan oleh Baileys dan Sharp
RUN apt-get update && apt-get install -y \
    ffmpeg \
    imagemagick \
    webp \
    libvips-dev && \
    rm -rf /var/lib/apt/lists/*

# Tentukan folder kerja
WORKDIR /app

# Salin package.json dan package-lock.json (jika ada)
COPY package*.json ./

# PAKSA instalasi modul di sini
RUN npm install --production

# Baru salin semua file lainnya
COPY . .

# Ekspos port agar Koyeb tidak mematikan instance
EXPOSE 8080

# Jalankan bot
CMD ["node", "index.js"]
